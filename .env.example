# Copy to .env for local development; never commit .env.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///instance/training.db
# Docker Compose overrides DATABASE_URL to use PostgreSQL.
MAX_UPLOAD_MB=500
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Set both only when you want to create the first admin automatically.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# OpenAI-compatible chat completions API; leave blank to disable AI report generation.
COOKIE_SECURE=false
SESSION_HOURS=8

# Docker Compose PostgreSQL password (required for Compose)
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# AI settings default to the local Ollama container in docker-compose.yml; override here only if needed.
